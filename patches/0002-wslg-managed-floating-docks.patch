+static bool ozoneWslgFloatingDock(const QWidget *widget)
+{
+    if (!widget->isWindow() || widget->windowType() != Qt::Tool
+        || (widget->windowFlags() & Qt::X11BypassWindowManagerHint)
+        || !widget->inherits("QDockWidget")
+        || !QCoreApplication::applicationFilePath().endsWith(QLatin1String("/Ozone")))
+        return false;
+
+    const QByteArray display(DisplayString(X11->display));
+    if (!display.startsWith(':'))
+        return false;
+    const int screenSeparator = display.indexOf('.', 1);
+    const QByteArray displayPart = display.mid(1, screenSeparator < 0 ? -1 : screenSeparator - 1);
+    bool valid = false;
+    const unsigned int displayNumber = displayPart.toUInt(&valid);
+    if (!valid || displayPart != QByteArray::number(displayNumber))
+        return false;
+
+    const QByteArray localSocket = "/tmp/.X11-unix/X" + displayPart;
+    const QByteArray wslgSocket = "/mnt/wslg/.X11-unix/X" + displayPart;
+    struct stat localInfo;
+    struct stat wslgInfo;
+    return stat(localSocket.constData(), &localInfo) == 0
+        && stat(wslgSocket.constData(), &wslgInfo) == 0
+        && S_ISSOCK(localInfo.st_mode)
+        && localInfo.st_dev == wslgInfo.st_dev && localInfo.st_ino == wslgInfo.st_ino;
+}
